# ASP.NET Core configuration uses double underscores for nested keys.
DBCONFIGURATION__CONNECTIONSTRING=mongodb://mongo:27017
DBCONFIGURATION__DATABASENAME=LearningManagementSystem
JWT__ISSUER=LearningManagementSystem
JWT__SECRETKEY=replace-with-a-random-secret-at-least-32-characters
JWT__EXPIRATIONINMINUTES=60
ASPNETCORE_ENVIRONMENT=Development
